{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://checkoutguard.local/schema/guard_output.json",
  "title": "GuardOutput",
  "description": "What the checkout guard returns before a shopper pays.",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "attack_type", "evidence", "instruction"],
  "properties": {
    "verdict": {"enum": ["block", "pass"]},
    "attack_type": {
      "enum": [
        "none",
        "hidden_fees",
        "preselected_addon",
        "price_change",
        "subscription_trap",
        "copycat_domain",
        "fake_card_verification",
        "listing_injection"
      ]
    },
    "evidence": {"type": "string"},
    "instruction": {"type": "string"}
  }
}
