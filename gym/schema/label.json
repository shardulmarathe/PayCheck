{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://checkoutguard.local/schema/label.json",
  "title": "PageLabel",
  "description": "One JSONL row. bbox is null when the page is clean.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "page_id",
    "store",
    "family",
    "attack_type",
    "verdict",
    "selector",
    "bbox",
    "evidence_text",
    "instruction",
    "source",
    "split"
  ],
  "properties": {
    "page_id": {"type": "string", "minLength": 1},
    "store": {"type": "string", "minLength": 1},
    "family": {"enum": ["upsell", "scam", "clean"]},
    "attack_type": {
      "enum": [
        "none",
        "hidden_fees",
        "preselected_addon",
        "price_change",
        "subscription_trap",
        "copycat_domain",
        "fake_card_verification",
        "listing_injection"
      ]
    },
    "verdict": {"enum": ["block", "pass"]},
    "selector": {"type": "string"},
    "bbox": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "prefixItems": [
            {"type": "integer"},
            {"type": "integer"},
            {"type": "integer"},
            {"type": "integer"}
          ],
          "minItems": 4,
          "maxItems": 4,
          "items": false
        }
      ]
    },
    "evidence_text": {"type": "string"},
    "instruction": {"type": "string"},
    "source": {
      "type": "string",
      "pattern": "^(template|ec-darkpattern|attacker-round[0-9]+)$"
    },
    "split": {"enum": ["train", "test"]}
  }
}
